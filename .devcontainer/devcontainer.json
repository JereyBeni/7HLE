{
  "name": "7HLE Development Environment",
  "image": "mcr.microsoft.com/devcontainers/rust:1-1-bullseye",
  
  // Extensiones útiles de VS Code que se instalan solas en tu Codespace
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "serayuzgur.crates"
      ]
    }
  },

  // Comando que corre al iniciar el Codespace para verificar que todo carbure
  "postCreateCommand": "rustc --version && cargo --version"
}